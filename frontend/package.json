{
  "name": "loop-dynamics-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:routes": "node --test route-manifest.test.mjs",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:routes && pnpm test:a11y && pnpm test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "4.14.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "5.1.1"
  }
}
